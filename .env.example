# Copy to .env and fill in. Never commit .env.
# Variables marked (web) are read by the Next.js server; only NEXT_PUBLIC_* reach the browser.

# Models
MODEL_PROVIDER=
MODEL_STRONG=
MODEL_FAST=
MODEL_API_KEY=
# JSON price table in USD per million tokens, e.g. {"model-name": {"in": 3.0, "out": 15.0}}
MODEL_PRICES=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=

# Database
# Pooled connection, used by the API
DATABASE_URL=postgresql://cw:cw@localhost:5432/context_window
# Non-pooled connection, used by the worker and the LangGraph checkpointer
DATABASE_URL_DIRECT=postgresql://cw:cw@localhost:5432/context_window
LANGGRAPH_STRICT_MSGPACK=true

# Tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=context-window
LANGSMITH_TRACING=true

# Sources
GITHUB_TOKEN=
# Optional
HF_TOKEN=
MAX_FETCH_BYTES=2000000

# App
API_HOST=127.0.0.1
PORT=8000
WORKER_HEARTBEAT_SECONDS=30
ADMIN_TOKEN=
BRIEFING_TZ=Asia/Kolkata
# manual locally, auto in production
REVIEW_MODE=manual
REVIEW_TIMEOUT_HOURS=3
MAX_STORIES=10
FACT_CHECK_POOL=14
MAX_ITEMS_PER_BEAT=40
MAX_MODEL_CALLS_PER_RUN=150
MAX_COST_PER_RUN_USD=1.50
PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Web (server side only)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
REVALIDATE_SECRET=
# Web (exposed to the browser; never put a secret here)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Deployment
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
RESEND_API_KEY=
RESEND_FROM=
BRIEFING_EMAIL_TO=
