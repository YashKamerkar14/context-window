# Copy to .env and fill in. Never commit .env.
# Variables marked (web) are read by the Next.js server; only NEXT_PUBLIC_* reach the browser.

# Models
MODEL_PROVIDER=openrouter
MODEL_STRONG=anthropic/claude-haiku-5.5
MODEL_FAST=anthropic/claude-haiku-5.5
MODEL_API_KEY=
# JSON price table in USD per million tokens. Every model above needs an entry.
# Check the provider's current list prices: https://openrouter.ai/models
MODEL_PRICES={"anthropic/claude-haiku-5.5": {"in": 0.10, "out": 0.50}, "openai/text-embedding-3-small": {"in": 0.02, "out": 0}}
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
# Optional: defaults to MODEL_API_KEY
EMBEDDING_API_KEY=

# Database
# Pooled connection, used by the API
DATABASE_URL=postgresql://cw:cw@localhost:5433/context_window
# Non-pooled connection, used by the worker and the LangGraph checkpointer
DATABASE_URL_DIRECT=postgresql://cw:cw@localhost:5433/context_window
LANGGRAPH_STRICT_MSGPACK=true
# Optional: database for tests. Defaults to DATABASE_URL_DIRECT; tests use a throwaway schema.
TEST_DATABASE_URL=

# Tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=context-window
LANGSMITH_TRACING=true

# Sources
GITHUB_TOKEN=
MAX_FETCH_BYTES=2000000

# App
API_HOST=127.0.0.1
PORT=8000
WORKER_HEARTBEAT_SECONDS=30
ADMIN_TOKEN=
BRIEFING_TZ=Asia/Kolkata
# manual locally, auto in production
REVIEW_MODE=manual
REVIEW_TIMEOUT_HOURS=3
MAX_STORIES=10
FACT_CHECK_POOL=14
MAX_ITEMS_PER_BEAT=40
MAX_MODEL_CALLS_PER_RUN=150
MAX_COST_PER_RUN_USD=1.50
WEB_ORIGIN=http://localhost:3000

# Web (server side only)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
REVALIDATE_SECRET=
# Web (exposed to the browser; never put a secret here)
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub Actions dispatch (the API uses this to start and resume runs)
# Fine-grained token: this repo only, permission "Actions: read and write"
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=YashKamerkar14/context-window

# Email
RESEND_API_KEY=
RESEND_FROM=
BRIEFING_EMAIL_TO=
